# Finlume AI Production Environment Variables Template

# ----------------------------------------------------
# DATABASE
# ----------------------------------------------------
# Define your PostgreSQL connection securely.
# Example: postgresql://finlume_user:finlume_password@<host>:<port>/finlume_db
DATABASE_URL=

# ----------------------------------------------------
# SECURITY / AUTHENTICATION
# ----------------------------------------------------
# JWT Secret Key for token encoding (must be a strong, cryptographically secure random string)
JWT_SECRET=supersecretkey-replace-in-production

# ----------------------------------------------------
# AI & OCR PROVIDERS
# ----------------------------------------------------
# Required for orchestration
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# ----------------------------------------------------
# APPLICATION ENVIRONMENT
# ----------------------------------------------------
# 'production' or 'development'
APP_ENV=production

# Determines logging verbosity (INFO, DEBUG, ERROR, etc.)
LOG_LEVEL=INFO

# Railway injected port
PORT=8000

# ----------------------------------------------------
# FRONTEND / CORS
# ----------------------------------------------------
# Define the frontend origin for CORS (e.g., https://your-railway-frontend-url.up.railway.app)
FRONTEND_ORIGIN=http://localhost

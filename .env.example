# Backend Database
DATABASE_URL=postgresql://user:password@localhost:5432/finlumedb

# Chroma DB standalone url if configured externally
CHROMA_URL=http://localhost:8000

# Security (JWT Generator)
JWT_SECRET=replace_this_with_a_highly_secure_random__key_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Keys
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# App configuration
LOG_LEVEL=INFO
APP_ENV=production
FRONTEND_ORIGIN=http://localhost

# API Rate Limits
RATE_LIMIT_AI=10/minute
RATE_LIMIT_DEFAULT=60/minute
